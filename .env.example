# Copy to .env and fill in real values. See README.md for setup steps.

# PostgreSQL connection string (Railway provides this automatically in prod)
DATABASE_URL=postgresql://user:password@localhost:5432/partysnap

# Google OAuth credentials — console.cloud.google.com → Credentials
# Authorized redirect URI must be <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Base URL of the app
NEXTAUTH_URL=http://localhost:3000

# Session encryption secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me

# Optional. Set to "true" to expose /api/debug/* in production.
# Leave unset — these endpoints report token and Drive state.
# ENABLE_DEBUG_ENDPOINTS=false
